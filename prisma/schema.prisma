generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // already comming from prisma.config.ts
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

