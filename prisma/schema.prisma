model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  credits Int @default(100)

  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  creditTransactions CreditTransaction[]

  // NEW: Social media settings

  // This design deliberately supports one Facebook Page and one Instagram 
  // account per user for your first version. If you later want users to connect
  //  multiple Facebook Pages or Instagram accounts, you will need to change the uniqueness 
  //constraint and update the UI.

  // The profileUrl can be saved before authorization, but 
  // the status must remain NOT_CONNECTED until Meta OAuth has actually verified the account.
  socialConnections  SocialConnection[]
  socialPreference   SocialPreference?
  socialOAuthPending SocialOAuthPending[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SOCIAL MEDAI LINKING START - 03.11.26
enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

enum SocialConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  EXPIRED
  REVOKED
}

model SocialConnection {
  id       String         @id @default(cuid())
  userId   String
  platform SocialPlatform

  // User-entered profile link
  profileUrl String? @db.Text

  // Verified details returned by Meta OAuth
  platformAccountId String?
  accountName       String?
  username          String?

  status SocialConnectionStatus @default(NOT_CONNECTED)

  // Never store plaintext OAuth tokens
  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  tokenExpiresAt        DateTime?

  // The permissions actually granted by the provider
  grantedScopes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // First version: one saved account per platform per user
  @@unique([userId, platform])
  @@index([platform, platformAccountId])
}

model SocialPreference {
  id     String @id @default(cuid())
  userId String @unique

  showPublishingPrompt Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialOAuthPending {
  id                String   @id @default(cuid())
  userId            String
  selectionKeyHash  String   @unique
  accountsEncrypted String   @db.Text
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// SOCIAL MEDAI LINKING END - 03-11-26

model Project {
  id     String  @id @default(cuid())
  userId String
  name   String?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]
  jobs   GenerationJob[]

  // Property Prep Studio
  propertyPhotos PropertyPhoto[]
  videoSettings  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id        String @id @default(cuid())
  projectId String

  type        AssetType
  url         String    @db.Text
  storagePath String?   @db.Text

  // Useful for images
  roomType String?

  // For generated assets
  sourceAssetId String?
  sourceAsset   Asset?  @relation("AssetVersions", fields: [sourceAssetId], references: [id])
  versions      Asset[] @relation("AssetVersions")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  inputJobs  GenerationJob[] @relation("JobInputAsset")
  outputJobs GenerationJob[] @relation("JobOutputAsset")

  jobInputs GenerationJobInput[]

  originalPropertyPhotos PropertyPhoto[] @relation("OriginalPhoto")
  selectedPropertyPhotos PropertyPhoto[] @relation("SelectedPhoto")

  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

enum AssetType {
  ORIGINAL_IMAGE
  GENERATED_IMAGE
  VIDEO
}

model GenerationJobInput {
  id        String @id @default(cuid())
  jobId     String
  assetId   String
  sortOrder Int    @default(0)

  job   GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([jobId, assetId])
  @@index([jobId])
}

model GenerationJob {
  id        String @id @default(cuid())
  projectId String

  type   GenerationType
  status GenerationStatus @default(PROCESSING)

  requestId       String? @unique
  creditCost      Int
  creditsDeducted Boolean @default(false)
  creditsRefunded Boolean @default(false)

  prompt   String? @db.Text
  settings Json?

  inputAssetId  String?
  outputAssetId String?

  errorMessage String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  inputAsset  Asset? @relation("JobInputAsset", fields: [inputAssetId], references: [id])
  outputAsset Asset? @relation("JobOutputAsset", fields: [outputAssetId], references: [id])

  inputAssets GenerationJobInput[]

  creditTransactions CreditTransaction[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

enum GenerationType {
  STAGING
  DECLUTTER
  VIDEO
}

enum GenerationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String

  amount      Int
  type        CreditTransactionType
  description String?

  // Link to generation/payment if necessary
  jobId     String?
  paymentId String? @unique // unique - preventing - Stripe can deliver the same webhook more than once.

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model PropertyPhoto {
  id              String @id @default(cuid())
  projectId       String
  originalAssetId String
  selectedAssetId String
  sortOrder       Int

  roomType       String?
  roomTypeSource String?
  analysis       Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  originalAsset Asset @relation("OriginalPhoto", fields: [originalAssetId], references: [id])
  selectedAsset Asset @relation("SelectedPhoto", fields: [selectedAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sortOrder])
  @@index([projectId])
}

enum CreditTransactionType {
  PURCHASE
  GENERATION
  REFUND
  BONUS
  ADJUSTMENT
}
